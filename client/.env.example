# Leave empty in local dev (Vite proxies /api to VITE_API_PROXY_TARGET). In production set this to the server deployment origin, e.g. https://hcm-lite-api.vercel.app
VITE_API_URL=
# Optional Vite development proxy target. Defaults to http://localhost:3000.
VITE_API_PROXY_TARGET=http://localhost:3000
# Show demo logins on the sign-in page (only useful after `npm run seed`)
VITE_SHOW_DEMO=false
