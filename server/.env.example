PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite
# Optional comma-separated DNS server IPs for MongoDB Atlas SRV lookup
MONGODB_DNS_SERVERS=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# SMTP credentials for welcome emails and sign-in verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
APP_TZ=Asia/Karachi
# AI assistant (Anthropic API). Leave blank to run without AI (rule-based fallback for leave drafts).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
