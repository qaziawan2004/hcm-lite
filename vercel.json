{
  "version": 2,
  "installCommand": "npm install --include=optional",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
    
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  }
}
