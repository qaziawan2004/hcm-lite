{
  "version": 2,
  "installCommand": "npm install --include=optional",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev --workspace hcm-lite-client -- --host 0.0.0.0 --port $PORT",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__api_path=:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
    
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
